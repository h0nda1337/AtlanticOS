+/* Native RSR version state from bsd/kern/kern_exec.c (XNU f6217f891ac0).
+ * The firmware profile retains the version accessors used by VM shared regions.
+ */
+#if !CONFIG_ATLANTIC_FIRMWARE || defined(MACH_BSD)
+#error "Atlantic RSR version state requires firmware without BSD"
+#endif
+
+#include <mach/shared_region.h>
+#include <machine/atomic.h>
+
+static uint32_t rsr_current_version = 0;
+
+uint32_t
+rsr_get_version(void)
+{
+	return os_atomic_load(&rsr_current_version, relaxed);
+}
+
+void
+rsr_bump_version(void)
+{
+	os_atomic_inc(&rsr_current_version, relaxed);
+}
