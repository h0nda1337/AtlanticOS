inline static processor_set_t
next_pset(processor_set_t pset)
{
 pset_map_t map = pset->node->pset_map;

 int pset_id = lsb_next(map, pset->pset_id);
 if (pset_id == -1) {
  pset_id = lsb_first(map);
 }

 return pset_array[pset_id];
}




